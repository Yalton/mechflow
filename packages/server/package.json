{
  "name": "@mechflow/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Dalton Bailey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yalton/mechflow.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mechflow-serve": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@mechflow/core": "workspace:*",
    "@mechflow/files": "workspace:*",
    "chokidar": "^3.6.0",
    "fflate": "^0.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
